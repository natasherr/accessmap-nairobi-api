# Supabase PostgreSQL connection strings
# Get the real values from Tonnybrian directly — never commit actual credentials here

# Pooled connection — used by the running app (server.js)
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-1-region.pooler.supabase.com:6543/postgres"

# Direct connection — used only for running Prisma migrations
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres"
PARTNER_URL="Get this url from the code"
PORT="get this too from  the code"
ALLOW_PARTNER_WRITES="set to the correct values when you woud want to add writes into group 11"