# ── AccessMap Nairobi API — environment variables ─────────────────────────
# Copy this file to server/.env and fill in real values.
# Never commit server/.env — it is gitignored.

# Supabase PostgreSQL — pooled connection used by the running server
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Separate, seeded database for server tests. Tests create venues and reports.
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/accessmap_test"

# Supabase PostgreSQL — direct connection (migrations only)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Port the Express server listens on (Render sets this automatically)
PORT=5000

# Group 11 Voter Edu API. Keep the real key in server/.env or your backend host's
# environment settings; never place it in frontend code or commit it.
PARTNER_URL=https://voter-edu-backend.onrender.com/api
PARTNER_API_KEY=replace-with-your-private-group-11-key

# Exact frontend origins allowed to read venue, report, and partner data.
PUBLIC_READ_ORIGINS=http://localhost:5173

# Set to "true" only when explicitly running write tests against the partner API
# Leave empty or "false" in normal operation — writes affect their live database
ALLOW_PARTNER_WRITES=false
